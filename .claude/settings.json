{
  "permissions": {
    "allow": [
      "Bash(npm run setup)",
      "Bash(npm run dev)",
      "Bash(npm run build)",
      "Bash(npm test)",
      "Bash(npm test *)",
      "Bash(npm run test *)",
      "Bash(npm run lint)",
      "Bash(npm run format)",
      "Bash(npm run typecheck)",
      "Bash(npm run typegen)",
      "Bash(npm run db:generate)",
      "Bash(npm run db:migrate:local)",
      "Bash(npm run db:reset)",
      "Bash(npx wrangler d1 migrations apply DB --local)",
      "Bash(npx wrangler d1 execute DB --local *)"
    ],
    "deny": [
      "Read(**/.dev.vars)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Bash(*wrangler deploy*)",
      "Bash(*wrangler versions deploy*)",
      "Bash(*wrangler rollback*)",
      "Bash(*wrangler secret*)",
      "Bash(*--remote*)"
    ]
  },
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  },
  "enabledPlugins": {
    "ui-ux-pro-max@ui-ux-pro-max-skill": true,
    "ponytail@ponytail": true
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  }
}
